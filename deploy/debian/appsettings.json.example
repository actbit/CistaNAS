{
  "AllowedHosts": "nas.example.com",
  "CistaNas": {
    "DataRoot": "/var/lib/cistanas/data",
    "TrustedProxies": [
      "127.0.0.1",
      "::1"
    ],
    "Network": {
      "SchemeMode": "proxy"
    },
    "Database": {
      "Provider": "sqlite"
    },
    "Storage": {
      "Provider": "local",
      "VolumeDataPath": "/var/lib/cistanas/data"
    },
    "Jwt": {
      "SigningKey": "REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"
    },
    "Auth": {
      "DefaultAdminUser": "admin",
      "DefaultAdminPassword": "REPLACE_WITH_A_LONG_RANDOM_PASSWORD"
    }
  }
}
