@page "/volumes"
@using CistaNAS.Wasm.Auth
@using CistaNAS.Wasm.Services
@using CistaNAS.Wasm.Models
@implements IDisposable
@inject VolumeApiClient VolumeApi
@inject AccountApiClient AccountApi
@inject E2eeApiClient E2eeApi
@inject GroupApiClient GroupApi
@inject EncryptionSettingsClient EncSettingsApi
@inject E2eeInterop E2ee
@inject ClientVolumeMountService MountService
@inject E2eeKeyResolverService KeyResolver
@inject WasmAuthStateProvider Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>ボリューム - CistaNAS</PageTitle>

@if (!Auth.IsLoggedIn)
{
    <div class="alert alert-warning">ログインしてください。</div>
    <a href="/login" class="btn btn-primary">ログイン</a>
}
else
{
    <h1>ボリューム管理</h1>

    <!-- ボリューム作成 -->
    <div class="card mb-4">
        <div class="card-header">ボリューム作成</div>
        <div class="card-body">
            <div class="form-narrow">
                <div class="mb-3">
                    <label class="form-label">名前</label>
                    <input class="form-control" @bind="_createModel.Name" placeholder="例: data" />
                </div>
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="chkEncrypted" @bind="_createModel.Encrypted" />
                    <label class="form-check-label" for="chkEncrypted">暗号化する</label>
                </div>
                @if (_createModel.Encrypted)
                {
                    <div class="mb-3">
                        <label class="form-label">暗号化方式</label>
                        <div class="form-check">
                            <input type="radio" class="form-check-input" name="encMode" id="encServer"
                                   checked="@(_createModel.EncryptionMode == "server")"
                                   @onchange="@(() => _createModel.EncryptionMode = "server")" />
                            <label class="form-check-label" for="encServer">
                                サーバー暗号化（AES-XTS）
                            </label>
                        </div>
                        <div class="form-check">
                            <input type="radio" class="form-check-input" name="encMode" id="encE2ee"
                                   checked="@(_createModel.EncryptionMode == "e2ee")"
                                   @onchange="@(() => _createModel.EncryptionMode = "e2ee")" />
                            <label class="form-check-label" for="encE2ee">
                                E2EE（エンドツーエンド暗号化）
                            </label>
                        </div>
                        <div class="form-check">
                            <input type="radio" class="form-check-input" name="encMode" id="encGroupE2ee"
                                   checked="@(_createModel.EncryptionMode == "group-e2ee")"
                                   @onchange="@(() => _createModel.EncryptionMode = "group-e2ee")" />
                            <label class="form-check-label" for="encGroupE2ee">
                                グループ E2EE（ECDH 共有対応）
                            </label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">パスワード（確認用）</label>
                        <input type="password" class="form-control" @bind="_createModel.Password" />
                    </div>
                }
                @if (_createModel.Encrypted && _createModel.EncryptionMode == "e2ee")
                {
                    <div class="alert alert-info">
                        <strong>E2EE ボリューム</strong>: マスターキーはブラウザ内で生成され、サーバーには送信されません。
                        パスワードを紛失するとデータを復旧できません。
                    </div>
                }
                else if (_createModel.Encrypted && _createModel.EncryptionMode == "group-e2ee")
                {
                    <div class="alert alert-info">
                        <strong>グループ E2EE ボリューム</strong>: ECDH 鍵交換でメンバー間共有が可能な E2EE ボリューム。
                        マスターキーはパスワードでラップし、メンバー追加時に公開鍵で ECIES ラップします。
                    </div>
                }
                else if (_createModel.Encrypted)
                {
                    <div class="alert alert-info">
                        ユーザー <strong>@Auth.CurrentUsername</strong> の認証情報でマスター鍵を暗号化します。
                    </div>
                }
            </div>
            <button class="btn btn-success" disabled="@_isCreating" @onclick="HandleCreate">
                @(_isCreating ? "作成中..." : "作成")
            </button>
            @if (_createError is not null)
            {
                <div class="alert alert-danger mt-2">@_createError</div>
            }
        </div>
    </div>

    <!-- ボリューム一覧 -->
    <h2>ボリューム一覧</h2>
    @if (_isLoading)
    {
        <p>読み込み中...</p>
    }
    else if (_volumes is null || _volumes.Count == 0)
    {
        <p>ボリュームがありません。</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>名前</th>
                        <th>暗号化</th>
                        <th class="d-none d-md-table-cell">所有ユーザー</th>
                        <th class="d-none d-md-table-cell">共有</th>
                        <th>状態</th>
                        <th class="d-none d-md-table-cell">使用量</th>
                        <th class="d-none d-lg-table-cell">作成日</th>
                        <th class="text-nowrap">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in _volumes)
                    {
                        <tr>
                            <td>
                                @v.Name
                                @if (v.IsHome)
                                {
                                    <span class="badge bg-info ms-1">Home</span>
                                }
                            </td>
                            <td>
                                @if (v.EncryptionMode == "e2ee" || v.EncryptionMode == "group-e2ee")
                                {
                                    <span class="badge bg-info">E2EE</span>
                                }
                                else if (v.Encrypted)
                                {
                                    <span class="badge bg-primary">サーバー</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">なし</span>
                                }
                            </td>
                            <td class="d-none d-md-table-cell">@v.OwnerUser</td>
                            <td class="d-none d-md-table-cell">@(v.AuthorizedUsers.Count > 1 ? $"{v.AuthorizedUsers.Count} ユーザー" : "-")</td>
                            <td>
                                @if (v.IsMounted)
                                {
                                    <span class="badge bg-success">マウント済み</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">未マウント</span>
                                }
                            </td>
                            <td class="d-none d-md-table-cell">
                                @if (_volumeStats.TryGetValue(v.Name, out var stats))
                                {
                                    <span class="text-muted small">@FormatFileSize(stats.UserUsedBytes) / @(stats.UserQuotaBytes > 0 ? FormatFileSize(stats.UserQuotaBytes) : "∞")</span>
                                }
                                else if (v.EncryptionMode == "e2ee" || v.EncryptionMode == "group-e2ee")
                                {
                                    <span class="text-muted small">-</span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td class="d-none d-lg-table-cell">@v.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                            <td>
                                @if (v.IsMounted)
                                {
                                    <button class="btn btn-sm btn-outline-danger me-1" @onclick="() => HandleLock(v.Name)">ロック</button>
                                    <a href="/files/@v.Name" class="btn btn-sm btn-outline-primary me-1">ファイル</a>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-primary me-1"
                                            @onclick="() => ShowMountDialog(v.Name, v.Encrypted, v.EncryptionMode)">マウント</button>
                                }
                                @if (v.OwnerUser == Auth.CurrentUsername && v.Encrypted && !v.IsHome)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ShowShareDialog(v.Name)">共有</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_lockError is not null)
    {
        <div class="alert alert-danger mt-2">@_lockError</div>
    }

    <!-- マウントダイアログ -->
    @if (_mountTarget is not null)
    {
        <div class="modal d-block modal-overlay" tabindex="-1">
            <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">マウント: @_mountTarget</h5>
                        <button type="button" class="btn-close" @onclick="CloseMountDialog"></button>
                    </div>
                    <div class="modal-body">
                        @if (_mountIsE2ee)
                        {
                            <div class="alert alert-warning">
                                E2EE ボリュームです。パスワードを入力するとブラウザ内でマスターキーが導出されます。
                                他のユーザーから E2EE 共有されたボリュームでは、ご自身の E2EE 鍵ペア生成時のパスワードを入力してください。
                            </div>
                            <div class="mb-3">
                                <label class="form-label">パスワード</label>
                                <input type="password" class="form-control" @bind="_mountPassword" />
                            </div>
                        }
                        else if (_mountNeedsPassword)
                        {
                            <div class="mb-3">
                                <label class="form-label">パスワード</label>
                                <input type="password" class="form-control" @bind="_mountPassword" />
                            </div>
                        }
                        else
                        {
                            <p>非暗号化ボリュームです。</p>
                        }
                        @if (_mountError is not null)
                        {
                            <div class="alert alert-danger">@_mountError</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseMountDialog">キャンセル</button>
                        <button type="button" class="btn btn-primary" disabled="@_isMounting" @onclick="HandleMount">
                            @(_isMounting ? "マウント中..." : "マウント")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- 共有ダイアログ -->
    @if (_shareTarget is not null)
    {
        <div class="modal d-block modal-overlay" tabindex="-1">
            <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">共有: @_shareTarget</h5>
                        <button type="button" class="btn-close" @onclick="CloseShareDialog"></button>
                    </div>
                    <div class="modal-body">
                        <h6>アクセス権のあるユーザー</h6>
                        <ul class="list-group mb-3">
                            @foreach (var u in _shareUsers)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    @u
                                    @if (u != Auth.CurrentUsername)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => HandleRevoke(_shareTarget, u)">削除</button>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">オーナー</span>
                                    }
                                </li>
                            }
                        </ul>
                        <hr />
                        <h6>ユーザーを追加</h6>
                        <div class="mb-2">
                            <input class="form-control mb-2" placeholder="ユーザー名" @bind="_grantUsername" />
                            <input type="password" class="form-control mb-2" placeholder="対象ユーザーのパスワード" @bind="_grantPassword" />
                            <input type="password" class="form-control mb-2" placeholder="自分のパスワード（確認）" @bind="_grantGranterPassword" />
                        </div>
                        @if (_shareError is not null)
                        {
                            <div class="alert alert-danger">@_shareError</div>
                        }

                        @if (!_shareIsE2ee)
                        {
                            <hr />
                            <h6>グループアクセス</h6>
                            @if (_shareGroups.Count > 0)
                            {
                                <ul class="list-group mb-2">
                                    @foreach (var gn in _shareGroups)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            @gn
                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => HandleRevokeGroup(_shareTarget!, gn)">削除</button>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="text-muted small">グループに共有されていません。</p>
                            }
                            <div class="row g-2 align-items-end">
                                <div class="col">
                                    <select class="form-select form-select-sm" @bind="_grantGroupName">
                                        <option value="">グループを選択</option>
                                        @foreach (var g in _availableGroups)
                                        {
                                            <option value="@g.GroupName">@g.GroupName</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-auto">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="HandleGrantGroup">追加</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <hr />
                            <h6>ECDH メンバー追加</h6>
                            <p class="form-text small">
                                相手ユーザーが公開鍵を登録している場合、ECDH で鍵を共有します。
                                初回のみ相手の公開鍵 fingerprint を記録し（TOFU）、以降は変更を検知して警告します。
                            </p>
                            @if (_shareKeyEpoch == 0)
                            {
                                <div class="alert alert-warning small">
                                    このボリュームは共有 v2 形式（GroupKey epoch 管理・per-file 鍵・改ざん検知の強化）に未移行です。
                                    メンバー追加・剥奪の前に移行すると、剥奪後の新データを剥奪ユーザーが読めなくなります（既読データの回収は保証しません）。
                                </div>
                                <button class="btn btn-sm btn-warning mb-2" disabled="@_isRotating"
                                        @onclick="HandleUpgradeToV2">
                                    @(_isRotating ? "移行中..." : "共有 v2 に移行（GroupKey epoch 開始）")
                                </button>
                            }
                            else
                            {
                                <p class="form-text small text-success">共有 v2: 現行 GroupKey epoch = @_shareKeyEpoch</p>
                            }
                            <div class="row g-2 align-items-end">
                                <div class="col">
                                    <input class="form-control form-control-sm" placeholder="ユーザー名" @bind="_ecdhUsername" />
                                </div>
                                <div class="col-auto">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="HandleEcdhGrant">ECDH 共有</button>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseShareDialog">閉じる</button>
                        @if (!_shareIsE2ee)
                        {
                            <button type="button" class="btn btn-primary" @onclick="HandleGrant">ユーザー追加</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- 公開鍵 pin 不一致警告（TOFU trust anchor 検証） -->
    @if (_pinMismatch is not null)
    {
        <div class="modal d-block modal-overlay" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">⚠ 公開鍵の変更を検知</h5>
                        <button type="button" class="btn-close" @onclick="ClosePinMismatch"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-danger">
                            <strong>@_pinMismatch.Username</strong> の暗号化公開鍵が以前確認したものから変更されています。
                            サーバー侵害または鍵更新の可能性があります。
                        </div>
                        <dl class="mb-2">
                            <dt class="small">以前の fingerprint (SHA-256)</dt>
                            <dd class="mb-2"><code class="text-break">@_pinMismatch.ExpectedFingerprint</code></dd>
                            <dt class="small">現在の fingerprint (SHA-256)</dt>
                            <dd><code class="text-break">@_pinMismatch.ActualFingerprint</code></dd>
                        </dl>
                        <p class="form-text small mb-0">
                            操作は中断されました。あて先が正しいか、相手に別の経路で確認してください。
                            「新しい鍵を信頼する」は、相手自身が鍵を更新したことを確認できた場合のみ実行してください。
                            pin はこのブラウザにのみ保存され、サーバーには送信されません。
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="ClosePinMismatch">キャンセル</button>
                        <button type="button" class="btn btn-danger" @onclick="TrustNewKeyAsync">新しい鍵を信頼する</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <a href="/" class="btn btn-secondary mt-3">ホームに戻る</a>
}

@code {
    private IReadOnlyList<VolumeInfo>? _volumes;
    private bool _isLoading = true;
    private string? _error;
    private Dictionary<string, E2eeVolumeStats> _volumeStats = new();

    // 作成フォーム
    private CreateModel _createModel = new() { Encrypted = true };
    private bool _isCreating;
    private string? _createError;

    // マウントダイアログ
    private string? _mountTarget;
    private bool _mountNeedsPassword;
    private bool _mountIsE2ee;
    private bool _isMounting;
    private string _mountPassword = "";
    private string? _mountError;

    // 共有ダイアログ
    private string? _shareTarget;
    private IReadOnlyList<string> _shareUsers = [];
    private bool _shareIsE2ee;
    private IReadOnlyList<string> _shareGroups = [];
    private IReadOnlyList<GroupEntity> _availableGroups = [];
    private string _grantGroupName = "";
    private string _grantUsername = "";
    private string _grantPassword = "";
    private string _grantGranterPassword = "";
    private string? _shareError;
    private string _ecdhUsername = "";

    private string? _lockError;

    // 公開鍵 pinning（TOFU trust anchor。pin は IndexedDB に origin ローカル保存）
    private PinMismatchInfo? _pinMismatch;

    // 共有 v2（GroupKey epoch）
    private int _shareKeyEpoch;
    private bool _isRotating;

    /// <summary>公開鍵 fingerprint の pin 不一致情報（サーバー送信なし、このブラウザ内のみ）。</summary>
    private sealed record PinMismatchInfo(string Username, string ExpectedFingerprint, string ActualFingerprint);

    private enum RotateResult { NotV2, Completed, Aborted }

    private sealed class CreateModel
    {
        public string Name { get; set; } = "";
        public string Password { get; set; } = "";
        public bool Encrypted { get; set; } = true;
        public string EncryptionMode { get; set; } = "server";
    }

    protected override async Task OnInitializedAsync()
    {
        Auth.StateChanged += OnAuthStateChanged;
        await LoadVolumesAsync();
    }

    private async Task LoadVolumesAsync()
    {
        if (!Auth.IsLoggedIn) { _isLoading = false; return; }
        _isLoading = true;

        try
        {
            _volumes = await VolumeApi.ListAsync();
            // E2EE ボリュームの使用量を取得
            _volumeStats.Clear();
            foreach (var v in _volumes)
            {
                if (v.EncryptionMode == "e2ee" || v.EncryptionMode == "group-e2ee")
                {
                    try
                    {
                        var stats = await E2eeApi.GetStatsAsync(v.Name);
                        _volumeStats[v.Name] = stats;
                    }
                    catch { /* 使用量取得失敗は無視 */ }
                }
            }
        }
        catch (Exception ex) { _error = $"エラー: {ex.Message}"; }
        finally { _isLoading = false; }
    }

    // ---- ボリューム作成 ----

    private async Task HandleCreate()
    {
        if (_isCreating) return;
        _isCreating = true;
        _createError = null;

        try
        {
            if (string.IsNullOrWhiteSpace(_createModel.Name))
            {
                _createError = "ボリューム名を入力してください。";
                return;
            }

            if (_createModel.Encrypted && _createModel.EncryptionMode == "e2ee")
            {
                await HandleCreateE2ee();
            }
            else if (_createModel.Encrypted && _createModel.EncryptionMode == "group-e2ee")
            {
                await HandleCreateGroupE2ee();
            }
            else
            {
                await VolumeApi.CreateAsync(
                    _createModel.Name.Trim(), Auth.CurrentUsername,
                    _createModel.Encrypted ? _createModel.Password : null,
                    _createModel.Encrypted);
            }

            _createModel = new() { Encrypted = true };
            await LoadVolumesAsync();
        }
        catch (Exception ex) { _createError = ex.Message; }
        finally { _isCreating = false; }
    }

    private async Task HandleCreateE2ee()
    {
        var wrappedKey = await CreatePasswordWrappedKeyAsync(_createModel.Password);
        await VolumeApi.CreateE2eeAsync(_createModel.Name.Trim(), Auth.CurrentUsername, wrappedKey);
    }

    private async Task HandleCreateGroupE2ee()
    {
        var ownerWrappedKey = await CreatePasswordWrappedKeyAsync(_createModel.Password, wrapType: "password");
        await VolumeApi.CreateGroupE2eeAsync(_createModel.Name.Trim(), ownerWrappedKey);
    }

    /// <summary>暗号化設定のキャッシュ（鍵導出スペック取得用）。取得失敗時はクライアント既定値。</summary>
    private EncryptionSettings? _encSettings;
    private async Task<EncryptionSettings> GetEncSettingsAsync()
    {
        if (_encSettings is not null) return _encSettings;
        try { _encSettings = await EncSettingsApi.GetAsync(); }
        catch { _encSettings = new EncryptionSettings(); }
        return _encSettings;
    }

    /// <summary>
    /// ブラウザ側 JS Interop でパスワードから KEK 導出（サーバー設定の KDF 種別に従う:
    /// Argon2id+PBKDF2 合成 or Argon2id 単独）→ マスターキー生成 → AES-256-GCM ラップを行い、
    /// サーバー送信用の UserWrappedKey を構築する。
    /// </summary>
    private async Task<UserWrappedKey> CreatePasswordWrappedKeyAsync(
        string password, string wrapType = "password")
    {
        var settings = await GetEncSettingsAsync();
        bool raw = string.Equals(settings.KdfAlgorithm, E2eeKdfOptions.Argon2idRaw, StringComparison.Ordinal);
        var kdf = raw
            ? E2eeKdfOptions.NewArgon2idRaw(settings.KdfMemoryKiB, settings.KdfTimeCost, settings.KdfParallelism)
            : E2eeKdfOptions.NewArgon2id(settings.KdfIterations, settings.KdfMemoryKiB, settings.KdfTimeCost, settings.KdfParallelism);
        byte[] salt = System.Security.Cryptography.RandomNumberGenerator.GetBytes(16);
        string saltB64 = Convert.ToBase64String(salt);
        string kekHandle = await E2ee.DeriveKek(password, saltB64, kdf, Auth.CurrentUsername);
        string mkHandle = await E2ee.GenerateMasterKey();
        var (nonceB64, ctB64, tagB64) = await E2ee.WrapMasterKey(mkHandle, kekHandle);
        await E2ee.ClearKey(kekHandle);
        await E2ee.ClearKey(mkHandle);

        return new UserWrappedKey
        {
            WrapType = wrapType,
            Kdf = new()
            {
                Algorithm = kdf.Algorithm,
                Iterations = kdf.Iterations,
                MemoryKiB = kdf.MemoryKiB,
                TimeCost = kdf.TimeCost,
                Parallelism = kdf.Parallelism,
                Salt = salt,
            },
            WrappedMasterKey = new()
            {
                Algorithm = "aes-256-gcm",
                Nonce = Convert.FromBase64String(nonceB64),
                Ciphertext = Convert.FromBase64String(ctB64),
                Tag = Convert.FromBase64String(tagB64),
            },
        };
    }

    private static UserWrappedKey BuildEcdhWrappedKey(
        string ephemeralPubKeyB64, string nonceB64, string ctB64, string tagB64)
    {
        return new UserWrappedKey
        {
            WrapType = "ecdh",
            EphemeralPublicKey = Convert.FromBase64String(ephemeralPubKeyB64),
            WrappedMasterKey = new()
            {
                Algorithm = "aes-256-gcm",
                Nonce = Convert.FromBase64String(nonceB64),
                Ciphertext = Convert.FromBase64String(ctB64),
                Tag = Convert.FromBase64String(tagB64),
            },
        };
    }

    // ---- マウント ----

    private void ShowMountDialog(string name, bool encrypted, string encryptionMode)
    {
        _mountTarget = name;
        _mountNeedsPassword = encrypted;
        _mountIsE2ee = encryptionMode == "e2ee" || encryptionMode == "group-e2ee";
        _mountPassword = "";
        _mountError = null;
        _isMounting = false;
    }

    private void CloseMountDialog()
    {
        _mountTarget = null;
        _mountError = null;
    }

    private async Task HandleMount()
    {
        _isMounting = true;
        _mountError = null;

        try
        {
            if (_mountIsE2ee)
            {
                // E2EE: サーバー側マウント（アクセス権チェック）+ クライアント側で鍵復号
                var volInfo = await VolumeApi.MountE2eeAsync(_mountTarget!, Auth.CurrentUsername);

                // 共有 v2: 自分宛ての全 epoch GroupKey をアンラップして保持
                // （v2 形式ファイル/ファイル名の読取には GroupKey、v1 形式残置ファイルの読取には masterKey を使う）
                var (groupKeys, volumeId) = await LoadGroupKeysForMountAsync(_mountPassword);

                // wrapped key を取得してアンラップ
                var wrappedKeyResp = await VolumeApi.GetWrappedKeyAsync(_mountTarget!, Auth.CurrentUsername);
                if (wrappedKeyResp is null)
                {
                    _mountError = "ラップ済み鍵が見つかりません。";
                    return;
                }

                string? mkHandle = null;
                try
                {
                    if (volumeId is null)
                    {
                        // v1 形式: wrapped key は masterKey
                        mkHandle = await UnwrapMyMasterKeyAsync(wrappedKeyResp, _mountPassword);
                    }
                    else if (volInfo.OwnerUser == Auth.CurrentUsername
                        && string.Equals(wrappedKeyResp.WrapType, "password", StringComparison.OrdinalIgnoreCase))
                    {
                        // 共有 v2 オーナー: 残置 v1 ファイルの読取用に masterKey もアンラップ
                        mkHandle = await UnwrapMyMasterKeyAsync(wrappedKeyResp, _mountPassword);
                    }
                    // 共有 v2 メンバーは GroupKey のみで v2 ファイルを読む（masterKey は持たない）

                    // クライアント側マウント状態に登録
                    MountService.MountE2ee(_mountTarget!, mkHandle, wrappedKeyResp.ChunkSize,
                        volInfo.EncryptionMode, volumeId, groupKeys);
                }
                catch
                {
                    // 鍵残留防止
                    if (mkHandle is not null) { try { await E2ee.ClearKey(mkHandle); } catch { } }
                    throw;
                }
            }
            else
            {
                await VolumeApi.MountAsync(_mountTarget!, Auth.CurrentUsername,
                    _mountNeedsPassword ? _mountPassword : null);
            }

            CloseMountDialog();
            await LoadVolumesAsync();
        }
        catch (Exception ex) { _mountError = ex.Message; }
        finally { _isMounting = false; }
    }

    // ---- ロック ----

    private async Task HandleLock(string name)
    {
        _lockError = null;
        try
        {
            // E2EE ボリュームの場合、JS 側の鍵ハンドルをクリア
            var (mounted, isE2ee) = MountService.GetMountStatus(name);
            if (mounted && isE2ee)
            {
                var handle = MountService.GetE2eeKeyHandle(name);
                if (handle is not null)
                {
                    try { await E2ee.ClearKey(handle); } catch { }
                }
            }
            await VolumeApi.LockAsync(name);
            MountService.Lock(name);
            await LoadVolumesAsync();
        }
        catch (Exception ex) { _lockError = ex.Message; }
    }

    // ---- 共有 ----

    private async Task ShowShareDialog(string name)
    {
        var vol = _volumes?.FirstOrDefault(v => v.Name == name);
        if (vol is null) return;

        _shareTarget = name;
        _shareUsers = vol.AuthorizedUsers;
        _shareIsE2ee = vol.EncryptionMode == "e2ee" || vol.EncryptionMode == "group-e2ee";
        _shareGroups = vol.AuthorizedGroups ?? [];
        _availableGroups = await GroupApi.ListGroupsAsync();
        _grantGroupName = "";
        _grantUsername = "";
        _grantPassword = "";
        _grantGranterPassword = "";
        _ecdhUsername = "";
        _shareError = null;
        _isRotating = false;
        _pinMismatch = null;

        // 共有 v2 の鍵 epoch（0 = 未移行）
        _shareKeyEpoch = 0;
        try
        {
            var gki = await VolumeApi.GetGroupKeyInfoAsync(name);
            _shareKeyEpoch = gki?.KeyEpoch ?? 0;
        }
        catch { /* 旧サーバー等では group-key-info が無い。v2 未移行として扱う */ }
    }

    private void CloseShareDialog()
    {
        _shareTarget = null;
        _shareError = null;
    }

    private async Task HandleGrant()
    {
        _shareError = null;
        try
        {
            await VolumeApi.GrantAccessAsync(_shareTarget!, _grantUsername.Trim(), _grantPassword, _grantGranterPassword);
            await LoadVolumesAsync();
            var vol = _volumes?.FirstOrDefault(v => v.Name == _shareTarget);
            if (vol is not null) _shareUsers = vol.AuthorizedUsers;
            _grantUsername = "";
            _grantPassword = "";
            _grantGranterPassword = "";
        }
        catch (Exception ex) { _shareError = ex.Message; }
    }

    private async Task HandleRevoke(string volumeName, string targetUser)
    {
        _shareError = null;
        var vol = _volumes?.FirstOrDefault(v => v.Name == volumeName);
        bool isE2eeOwner = vol is not null && vol.OwnerUser == Auth.CurrentUsername
            && (vol.EncryptionMode is "e2ee" or "group-e2ee");

        try
        {
            bool revokedByRotation = false;
            if (isE2eeOwner)
            {
                if (_grantGranterPassword.Length == 0)
                {
                    _shareError = "共有 v2 ボリュームでは、剥奪時に GroupKey をローテーションするため自分のパスワードを入力してください。";
                    return;
                }
                var result = await RotateGroupKeyAsync(volumeName, targetUser, _grantGranterPassword);
                if (result == RotateResult.Aborted) return; // pin 不一致で中断（削除していない）
                revokedByRotation = result == RotateResult.Completed;
            }

            if (!revokedByRotation)
                await VolumeApi.RevokeAccessAsync(volumeName, targetUser);

            await LoadVolumesAsync();
            var v = _volumes?.FirstOrDefault(v => v.Name == _shareTarget);
            if (v is not null) _shareUsers = v.AuthorizedUsers;
            _grantGranterPassword = "";
        }
        catch (Exception ex) { _shareError = ex.Message; }
    }

    private async Task HandleGrantGroup()
    {
        if (string.IsNullOrEmpty(_grantGroupName)) return;
        _shareError = null;
        try
        {
            await VolumeApi.GrantGroupAccessAsync(_shareTarget!, _grantGroupName);
            await LoadVolumesAsync();
            var vol = _volumes?.FirstOrDefault(v => v.Name == _shareTarget);
            if (vol is not null) _shareGroups = vol.AuthorizedGroups ?? [];
            _grantGroupName = "";
        }
        catch (Exception ex) { _shareError = ex.Message; }
    }

    private async Task HandleRevokeGroup(string volumeName, string groupName)
    {
        _shareError = null;
        try
        {
            await VolumeApi.RevokeGroupAccessAsync(volumeName, groupName);
            await LoadVolumesAsync();
            var vol = _volumes?.FirstOrDefault(v => v.Name == _shareTarget);
            if (vol is not null) _shareGroups = vol.AuthorizedGroups ?? [];
        }
        catch (Exception ex) { _shareError = ex.Message; }
    }

    private async Task HandleEcdhGrant()
    {
        _shareError = null;
        if (string.IsNullOrWhiteSpace(_ecdhUsername))
        {
            _shareError = "ユーザー名を入力してください。";
            return;
        }

        try
        {
            string username = _ecdhUsername.Trim();

            // 相手の公開鍵を取得
            string? recipientPubKey = await AccountApi.GetPublicKeyAsync(username);
            if (recipientPubKey is null)
            {
                _shareError = "相手ユーザーの公開鍵が登録されていません。先に設定ページで鍵ペアを生成してください。";
                return;
            }

            // TOFU pin 検証: 初回は fingerprint を記録、2 回目以降は一致検証。
            // 不一致時は中断し警告ダイアログを表示（自動的には新しい鍵を信頼しない）。
            if (!await VerifyOrCreatePinAsync(username, recipientPubKey))
                return;

            // 自分のパスワードで鍵をアンラップするため、パスワード入力が必要
            if (string.IsNullOrWhiteSpace(_grantGranterPassword))
            {
                _shareError = "自分のパスワードを入力してください（鍵復号用）。";
                return;
            }

            UserWrappedKey wrapped;
            var gki = await VolumeApi.GetGroupKeyInfoAsync(_shareTarget!);
            if (gki is not null && gki.KeyEpoch >= 1)
            {
                // 共有 v2: masterKey の代わりに現行 epoch GroupKey を新メンバーの公開鍵でラップ
                // （rotation は行わない — 追加メンバーは現行 epoch 以降のデータのみ読める）
                var myWrap = gki.MyGroupKeys.FirstOrDefault(k => k.Epoch == gki.KeyEpoch)
                    ?? throw new Exception("自分宛ての現行 epoch GroupKey がありません。");
                string groupKeyB64 = await UnwrapGroupKeyWithPasswordAsync(myWrap, gki.VolumeId, _grantGranterPassword);
                var (ephPubKey, nonce, ct, tag) = await E2ee.EcdhWrapGroupKey(
                    groupKeyB64, recipientPubKey, gki.VolumeId, gki.KeyEpoch, username);
                wrapped = BuildEcdhWrappedKey(ephPubKey, nonce, ct, tag);
            }
            else
            {
                // v1: 自分の masterKey をアンラップして相手の公開鍵で ECIES ラップ（従来フロー）
                var wrappedKeyResp = await VolumeApi.GetWrappedKeyAsync(_shareTarget!, Auth.CurrentUsername);
                if (wrappedKeyResp is null)
                {
                    _shareError = "自分の wrapped key が見つかりません。";
                    return;
                }
                string mkHandle = await UnwrapMyMasterKeyAsync(wrappedKeyResp, _grantGranterPassword);
                try
                {
                    var (ephPubKey, nonce, ct, tag) = await E2ee.EcdhWrap(mkHandle, recipientPubKey);
                    wrapped = BuildEcdhWrappedKey(ephPubKey, nonce, ct, tag);
                }
                finally { await E2ee.ClearKey(mkHandle); }
            }

            await VolumeApi.AddE2eeWrappedKeyAsync(_shareTarget!, username, wrapped);

            await LoadVolumesAsync();
            var vol = _volumes?.FirstOrDefault(v => v.Name == _shareTarget);
            if (vol is not null) _shareUsers = vol.AuthorizedUsers;
            _ecdhUsername = "";
            _grantGranterPassword = "";
        }
        catch (Exception ex) { _shareError = ex.Message; }
    }

    /// <summary>共有 v2 未移行の E2EE ボリュームを owner が移行する（GroupKey epoch 1 を生成）。</summary>
    private async Task HandleUpgradeToV2()
    {
        if (_shareTarget is null || _isRotating) return;
        _shareError = null;
        _isRotating = true;
        try
        {
            if (string.IsNullOrWhiteSpace(_grantGranterPassword))
            {
                _shareError = "移行には自分のパスワードが必要です（現行鍵の復旧・再ラップ用）。入力してから実行してください。";
                return;
            }
            var result = await RotateGroupKeyAsync(_shareTarget, targetUser: null, _grantGranterPassword);
            if (result == RotateResult.Aborted) return;
            _shareKeyEpoch += 1;
            _grantGranterPassword = "";
        }
        catch (Exception ex) { _shareError = ex.Message; }
        finally { _isRotating = false; }
    }

    // ---- 公開鍵 pinning（TOFU trust anchor）----

    /// <summary>
    /// TOFU pin 検証。pin 未登録なら fingerprint を記録して保存（初回使用）。
    /// 登録済みで fingerprint が一致しない場合は操作を中断し、警告ダイアログを表示して false を返す
    /// （自動的には新しい鍵を信頼しない。pin 更新はユーザーの明示操作のみ）。
    /// pin はこのブラウザの IndexedDB にのみ保存され、サーバーには送信されない。
    /// </summary>
    /// <summary>TOFU pin 検証（初回は記録）。不一致時は警告モーダル表示して false。</summary>
    private async Task<bool> VerifyOrCreatePinAsync(string username, string publicKeyBase64)
    {
        var (result, pin, fingerprint) = await KeyResolver.CheckPinAsync(username, publicKeyBase64);
        if (result == PinCheckResult.Mismatch)
        {
            _pinMismatch = new PinMismatchInfo(username, pin!.FingerprintSha256, fingerprint);
            return false;
        }
        return true;
    }

    private void ClosePinMismatch() => _pinMismatch = null;

    /// <summary>pin 不一致検知後の明示的な pin 更新（新しい鍵を信頼する）。
    /// pin 更新のみを行い、中断した共有操作は自動再実行しない（改めて操作を行うこと）。</summary>
    private async Task TrustNewKeyAsync()
    {
        if (_pinMismatch is null) return;
        await KeyResolver.TrustNewKeyAsync(_pinMismatch.Username, _pinMismatch.ActualFingerprint);
        _pinMismatch = null;
    }

    // ---- 共有 v2（GroupKey epoch / per-file DEK）共通ヘルパー（実装は E2eeKeyResolverService） ----

    /// <summary>localStorage の E2EE 秘密鍵を password で復号してハンドルを返す。未登録・password 不正時は例外。</summary>
    private Task<string> LoadE2eePrivateKeyAsync(string password)
        => KeyResolver.LoadPrivateKeyAsync(Auth.CurrentUsername, password);

    /// <summary>自分宛ての wrapped masterKey をアンラップしてハンドルを返す
    /// （ECDH wrap は E2EE 秘密鍵、password wrap は KEK 導出でアンラップ）。</summary>
    private Task<string> UnwrapMyMasterKeyAsync(WrappedKeyResponse wrappedKeyResp, string password)
        => KeyResolver.UnwrapMyMasterKeyAsync(wrappedKeyResp, Auth.CurrentUsername, password);

    /// <summary>自分宛ての GroupKey wrap を E2EE 秘密鍵（password 復号）でアンラップして base64 を返す。</summary>
    private Task<string> UnwrapGroupKeyWithPasswordAsync(GroupKeyWrapInfoJson wrap, string volumeId, string password)
        => KeyResolver.UnwrapGroupKeyAsync(wrap, volumeId, Auth.CurrentUsername, password);

    /// <summary>マウント時: 自分宛ての全 epoch GroupKey をアンラップする。v2 未移行ボリュームでは (空, null) を返す。</summary>
    private Task<(IReadOnlyDictionary<int, string> GroupKeys, string? VolumeId)> LoadGroupKeysForMountAsync(string password)
        => KeyResolver.LoadGroupKeysAsync(_mountTarget!, Auth.CurrentUsername, password);

    /// <summary>
    /// 共有 v2: 新 GroupKey を生成して remaining members（targetUser を除く全メンバー）の公開鍵で
    /// ECIES ラップし、rotate-group-key で epoch を進める。targetUser 指定時はそのユーザーの
    /// 鍵エントリも全削除される（revoke）。targetUser == null は v2 昇格（epoch 1 開始）。
    /// ローテーション後、旧 epoch の per-file DEK を新 epoch GroupKey に再ラップする（チャンク本体は不変）。
    /// v2 未移行ボリューム（昇格以外の呼び出し）では NotV2 を返し何もしない。
    /// </summary>
    private async Task<RotateResult> RotateGroupKeyAsync(string volumeName, string? targetUser, string password)
    {
        var gki = await VolumeApi.GetGroupKeyInfoAsync(volumeName);
        if (gki is null) return RotateResult.NotV2;
        string volumeId = gki.VolumeId;
        int currentEpoch = gki.KeyEpoch;
        int newEpoch = currentEpoch + 1;

        // 現行 epoch の GroupKey を取得（旧 per-file DEK の再ラップ用）
        string oldGroupKeyB64 = "";
        if (currentEpoch >= 1)
        {
            var myWrap = gki.MyGroupKeys.FirstOrDefault(k => k.Epoch == currentEpoch)
                ?? throw new Exception("自分宛ての現行 epoch GroupKey がありません。");
            oldGroupKeyB64 = await UnwrapGroupKeyWithPasswordAsync(myWrap, volumeId, password);
        }

        // remaining members（削除対象を除く）の公開鍵を取得して pin 検証 → wrap 生成
        var members = (await VolumeApi.GetMemberPublicKeysAsync(volumeName))
            .Where(m => m.Username != targetUser)
            .ToList();
        if (members.Count == 0)
            throw new Exception("remaining members がいません（自分宛ての wrap が少なくとも 1 つ必要です）。");

        string newGroupKeyB64 = await E2ee.GenerateGroupKeyV2();
        var wraps = new Dictionary<string, UserWrappedKey>();
        foreach (var m in members)
        {
            if (m.PublicKeyBase64 is null)
                throw new Exception($"ユーザー '{m.Username}' の公開鍵が未登録のため GroupKey をローテーションできません。");
            if (!await VerifyOrCreatePinAsync(m.Username, m.PublicKeyBase64))
                return RotateResult.Aborted; // pin 不一致 — 中断（鍵の削除も行わない）
            var (ephPubKey, nonce, ct, tag) = await E2ee.EcdhWrapGroupKey(
                newGroupKeyB64, m.PublicKeyBase64, volumeId, newEpoch, m.Username);
            wraps[m.Username] = BuildEcdhWrappedKey(ephPubKey, nonce, ct, tag);
        }

        if (targetUser is not null && wraps.ContainsKey(targetUser))
            throw new Exception("削除対象ユーザー宛ての wrap が含まれています。");
        if (!wraps.ContainsKey(Auth.CurrentUsername))
            throw new Exception("自分宛ての wrap が含まれていません（オーナーは remaining members に含まれる必要があります）。");

        await VolumeApi.RotateGroupKeyAsync(volumeName, newEpoch, wraps, removedUsername: targetUser);

        if (currentEpoch >= 1)
            await RewrapAllFileKeysAsync(volumeName, volumeId, currentEpoch, oldGroupKeyB64, newGroupKeyB64, newEpoch);

        return RotateResult.Completed;
    }

    /// <summary>旧 epoch の per-file DEK を新 epoch GroupKey に再ラップしてサーバーに登録する（チャンク本体は不変）。
    /// v1 形式ファイル（KeyEpoch == 0）は再ラップ対象外（オーナーの masterKey でのみ読めるまま）。</summary>
    private async Task RewrapAllFileKeysAsync(string volumeName, string volumeId,
        int oldEpoch, string oldGroupKeyB64, string newGroupKeyB64, int newEpoch)
    {
        var files = await E2eeApi.ListFilesAsync(volumeName);
        var rewraps = new List<E2eeRewrapFileKeyEntry>();
        foreach (var f in files.Files)
        {
            if (f.KeyEpoch != oldEpoch || f.WrappedFileKey is null) continue;
            string fileKeyB64 = await E2ee.UnwrapFileKey(
                Convert.ToBase64String(f.WrappedFileKey.Nonce),
                Convert.ToBase64String(f.WrappedFileKey.Ciphertext),
                Convert.ToBase64String(f.WrappedFileKey.Tag),
                oldGroupKeyB64, volumeId, f.FileId, f.KeyEpoch);
            var (nonce, ct, tag) = await E2ee.WrapFileKey(fileKeyB64, newGroupKeyB64, volumeId, f.FileId, newEpoch);
            rewraps.Add(new E2eeRewrapFileKeyEntry(f.FileId, newEpoch, new WrappedAeadKeyParams
            {
                Algorithm = "aes-256-gcm",
                Nonce = Convert.FromBase64String(nonce),
                Ciphertext = Convert.FromBase64String(ct),
                Tag = Convert.FromBase64String(tag),
            }));
        }
        if (rewraps.Count > 0)
            await VolumeApi.RewrapFileKeysAsync(volumeName, rewraps);
    }

    private async void OnAuthStateChanged()
    {
        StateHasChanged();
        if (Auth.IsLoggedIn && _volumes is null) await LoadVolumesAsync();
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024.0):F1} MB";
        return $"{bytes / (1024.0 * 1024.0 * 1024.0):F1} GB";
    }

    public void Dispose() => Auth.StateChanged -= OnAuthStateChanged;
}
