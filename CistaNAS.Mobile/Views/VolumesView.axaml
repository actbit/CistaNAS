<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CistaNAS.Mobile.Core.ViewModels"
             xmlns:api="using:CistaNAS.Client.Api"
             x:Class="CistaNAS.Mobile.Views.VolumesView"
             x:DataType="vm:VolumesViewModel">
  <Panel>
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
        <Button Content="更新" Command="{Binding RefreshCommand}" />
        <Button Content="作成..." Command="{Binding CreateVolumeCommand}" />
        <Button Content="ログアウト" Command="{Binding LogoutCommand}" />
      </StackPanel>

      <ListBox Grid.Row="1" ItemsSource="{Binding Volumes}" x:Name="VolumesList">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="api:VolumeListItem">
            <Button Content="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Background="Transparent" Padding="8"
                    Command="{Binding $parent[ListBox].DataContext.OpenVolumeCommand}" CommandParameter="{Binding}">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="16" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding EncryptionMode}" VerticalAlignment="Center"
                           Margin="8,2" Padding="6,2" FontSize="12"
                           Background="#E8F0FE" Foreground="#1F6FEB" />
                <TextBlock Grid.Column="2" Text="ロック中" VerticalAlignment="Center" Foreground="Gray"
                           IsVisible="{Binding !IsMounted}" />
              </Grid>
            </Button>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Grid.Row="1" Text="ボリュームがありません。「作成」から追加してください。"
                 Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding !HasVolumes}" />
    </Grid>

    <!-- マウント用パスワード入力オーバーレイ -->
    <Border IsVisible="{Binding IsMountPromptVisible}" Background="#80000000">
      <Border Background="{DynamicResource SystemRegionBrush}" CornerRadius="8" Padding="24"
              MaxWidth="420" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="ボリュームのパスワード" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="このパスワードで鍵を復号します。パスワードがサーバーに送信されることはありません。"
                     TextWrapping="Wrap" Foreground="Gray" FontSize="12" />
          <TextBox Text="{Binding MountPassword}" Watermark="パスワード" PasswordChar="●" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="キャンセル" Command="{Binding CancelMountCommand}" />
            <Button Content="マウント" Command="{Binding ConfirmMountCommand}"
                    Classes="accent" />
          </StackPanel>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" />
          <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                     Foreground="Crimson" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</UserControl>
