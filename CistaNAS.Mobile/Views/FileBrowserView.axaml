<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CistaNAS.Mobile.Core.ViewModels"
             x:Class="CistaNAS.Mobile.Views.FileBrowserView"
             x:DataType="vm:FileBrowserViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12,8">
    <!-- パンくず + 操作 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
      <Button Content="↑" Command="{Binding GoUpCommand}" IsVisible="{Binding CanGoUp}" />
      <TextBlock Text="{Binding CurrentPath}" VerticalAlignment="Center" Foreground="Gray" />
      <TextBlock Text="{Binding ModeBadge}" VerticalAlignment="Center" Margin="8,0"
                 Padding="6,2" FontSize="12" Background="#E8F0FE" Foreground="#1F6FEB" />
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
      <Button Content="更新" Command="{Binding RefreshCommand}" />
      <Button Content="ロック" Command="{Binding LockVolumeCommand}" IsVisible="{Binding IsE2ee}" />
    </StackPanel>

    <ScrollViewer Grid.Row="2">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:FileItem">
            <Button Content="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Background="Transparent" Padding="8,6"
                    Command="{Binding $parent[ItemsControl].DataContext.OpenItemCommand}" CommandParameter="{Binding}">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center"
                           Foreground="Gray" FontSize="12" Margin="8,0" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <ProgressBar Grid.Row="3" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" Margin="0,8,0,0" />
  </Grid>
</UserControl>
