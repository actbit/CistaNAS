<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CistaNAS.Mobile.Core.ViewModels"
             x:Class="CistaNAS.Mobile.Views.StreamingViewerView"
             x:DataType="vm:StreamingViewerViewModel">
  <StackPanel Spacing="16" Margin="24,32" MaxWidth="480" HorizontalAlignment="Stretch">
    <TextBlock Text="{Binding FileName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Text="動画・音声・PDFをアプリ内で表示します。ファイルの保存は行いません。"
               TextWrapping="Wrap" Foreground="Gray" FontSize="12" />
    <TextBlock Text="{Binding Status}" Foreground="Gray" TextWrapping="Wrap" />
    <Button Content="開く" Command="{Binding RetryCommand}" HorizontalAlignment="Left" Padding="24,10" />
    <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
               Foreground="Crimson" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
