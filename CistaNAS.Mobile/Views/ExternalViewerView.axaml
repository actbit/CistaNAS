<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CistaNAS.Mobile.Core.ViewModels"
             x:Class="CistaNAS.Mobile.Views.ExternalViewerView"
             x:DataType="vm:ExternalViewerViewModel">
  <StackPanel Spacing="16" Margin="24,32" MaxWidth="480" HorizontalAlignment="Stretch">
    <TextBlock Text="{Binding FileName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Text="この形式は外部アプリで開きます。ダウンロードが完了すると再生候補が起動します。"
               TextWrapping="Wrap" Foreground="Gray" FontSize="12" />

    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="8" />
    <TextBlock Text="{Binding Status}" Foreground="Gray" />

    <Button Content="再試行" Command="{Binding RetryCommand}" HorizontalAlignment="Left" Padding="24,10"
            IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
               Foreground="Crimson" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
