<Project Sdk="Microsoft.NET.Sdk">

  <!-- CistaNAS Android アプリ (Avalonia ヘッド)。ロジックは CistaNAS.Mobile.Core に集約。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <ApplicationId>com.cistanas.mobile</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <!-- 開発中は apk。配布時は aab に変更する。 -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Debug'">android-arm64</RuntimeIdentifier>
    <!-- Android packaging can reuse removed assets from a previous incremental
         APK. Keep opt-in test assemblies and assets in independent outputs. -->
    <IntermediateOutputPath Condition="'$(EnableAndroidSmokeTests)' == 'true'">obj\$(Configuration)\smoke\</IntermediateOutputPath>
    <OutputPath Condition="'$(EnableAndroidSmokeTests)' == 'true'">bin\$(Configuration)\smoke\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Android" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CistaNAS.Mobile.Core\CistaNAS.Mobile.Core.csproj" />
  </ItemGroup>

  <!-- Native test entry points are absent from ordinary and release APKs. -->
  <ItemGroup>
    <Compile Remove="Testing\**\*.cs" />
    <Compile Include="Testing\**\*.cs" Condition="'$(EnableAndroidSmokeTests)' == 'true' And '$(Configuration)' == 'Debug'" />
    <AndroidAsset Include="..\CistaNAS.Tests\TestResults\viewer-video.enc"
                  Link="viewer-video.enc" Condition="'$(EnableAndroidSmokeTests)' == 'true' And '$(Configuration)' == 'Debug'" />
  </ItemGroup>
  <Target Name="RejectReleaseSmokeTests" BeforeTargets="PrepareForBuild"
          Condition="'$(EnableAndroidSmokeTests)' == 'true' And '$(Configuration)' != 'Debug'">
    <Error Text="Android smoke entry points are allowed only in Debug test APKs." />
  </Target>

</Project>
